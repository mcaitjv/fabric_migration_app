{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Credits consumed per day with activity.",
  "width": "container",
  "height": "container",
  "encoding": {
    "x": {
      "field": "Date",
      "type": "temporal",
      "title": null,
      "axis": { "labelOverlap": true }
    },
    "y": {
      "field": "Credits",
      "type": "quantitative",
      "title": "Credits consumed"
    },
    "tooltip": [
      { "field": "Date", "type": "temporal", "title": "Date" },
      { "field": "Credits", "type": "quantitative", "title": "Credits consumed" },
      { "field": "Requests", "type": "quantitative", "title": "Requests" },
      { "field": "LLMCost", "type": "quantitative", "title": "LLM cost" }
    ]
  },
  "layer": [
    { "mark": { "type": "area", "line": true } }
  ]
}
